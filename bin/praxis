#!/usr/bin/env python3
"""praxis -- structured failure journals and analysis.

The Compounding Wisdom engine. Logs failures, detects patterns,
and surfaces systemic issues worth addressing.
"""

import json
import sys
import argparse
from pathlib import Path

# Add src/ to path so we can import without packaging
_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here.parent / "src"))

from praxis import failure, analysis


def cmd_log(args):
    """Write a failure journal entry."""
    report = failure.log_failure(
        mission_id=args.mission,
        step_id=args.step,
        tool=args.tool,
        error_type=args.error_type,
        error_message=args.message,
    )
    print(f"Logged: {report['id']} ({report['error_type']})")


def cmd_failures(args):
    """Query failure journals."""
    result = analysis.summarize(error_type=args.type, mission=args.mission)

    if args.json:
        print(json.dumps(result, indent=2))
        return

    print(f"Total: {result['total']}")
    if result["by_type"]:
        for et, count in result["by_type"].items():
            print(f"  {et}: {count}")
    if result["failures"]:
        print()
        for f in result["failures"]:
            print(f"  [{f['timestamp'][:10]}] {f['id']} "
                  f"{f['error_type']} -- {f['error_message']}")


def cmd_triggers(args):
    """Show error types that hit the Rule of Three."""
    results = analysis.triggers(threshold=args.threshold)

    if args.json:
        print(json.dumps(results, indent=2))
        return

    if not results:
        print("No error types have hit the threshold.")
        return

    for t in results:
        missions = ", ".join(t["missions"]) if t["missions"] else "none"
        print(f"  {t['error_type']}: {t['count']} failures "
              f"(missions: {missions})")


def cmd_timeline(args):
    """Show failure history for a mission."""
    entries = analysis.timeline(args.mission)

    if args.json:
        print(json.dumps(entries, indent=2))
        return

    if not entries:
        print(f"No failures recorded for mission: {args.mission}")
        return

    for f in entries:
        ts = f["timestamp"][:19].replace("T", " ")
        print(f"  {ts}  step {f['step']}  {f['tool']}  "
              f"{f['error_type']} -- {f['error_message']}")


def cmd_correlate(args):
    """Show failures alongside nearby decisions."""
    results = analysis.correlate(window_hours=args.window)
    if args.json:
        print(json.dumps(results, indent=2))
        return
    if not results:
        print("No failures recorded.")
        return
    for r in results:
        f = r["failure"]
        ts = f["timestamp"][:16].replace("T", " ")
        print(f"  {ts}  {f['id']}  {f['error_type']} -- {f['error_message']}")
        for d in r["nearby_decisions"]:
            print(f"    nearby: {d['id']} \"{d['decision']}\"")


def cmd_stale(args):
    """Show observations aging without action."""
    result = analysis.stale(days=args.days)
    if args.json:
        print(json.dumps(result, indent=2))
        return
    obs = result["stale_observations"]
    if not obs:
        print(f"No stale observations (threshold: {args.days} days).")
        return
    print(f"  Stale observations (> {args.days} days):")
    for o in obs:
        print(f"    {o['id']}  {o['timestamp'][:10]}  \"{o['content']}\"")
    print(f"  Total: {result['stale_count']} stale, {result['total_raw']} raw")


def cmd_friction(args):
    """Show failures mapped to project boundaries."""
    results = analysis.friction()
    if args.json:
        print(json.dumps(results, indent=2))
        return
    if not results:
        print("No failures mapped to project boundaries.")
        return
    for r in results:
        error_strs = [f"{et}: {count}" for et, count in r["error_types"].items()]
        print(f"  {r['boundary']} boundary: {r['failure_count']} failures "
              f"({', '.join(error_strs)})")
        for m in r["missions"]:
            print(f"    mission: {m}")


def cmd_blind_spots(args):
    """Show recurring failures without journal entries."""
    result = analysis.blind_spots(threshold=args.threshold)
    if args.json:
        print(json.dumps(result, indent=2))
        return
    orphaned = result["orphaned_failures"]
    if not orphaned:
        print("No blind spots detected.")
        return
    print("  Blind spots (failures without nearby decisions):")
    for o in orphaned:
        first = o["first_occurrence"][:10]
        latest = o["latest_occurrence"][:10]
        print(f"    {o['error_type']} / {o['mission']}: {o['count']} failures")
        print(f"      First: {first}, Latest: {latest}")
    print(f"  Total: {result['blind_spot_count']} blind spots")


def cmd_health(args):
    """Show ecosystem health summary."""
    result = analysis.health()
    if args.json:
        print(json.dumps(result, indent=2))
        return

    status = result["status"].upper()
    summary = result["summary"]

    print(f"Ecosystem Health: {status}")
    print()
    print("Summary:")
    print(f"  Failures: {summary['total_failures']} total, "
          f"{summary['recent_failures']} recent (7 days)")
    print(f"  Triggers: {summary['trigger_count']} error types hitting threshold")
    print(f"  Stale: {summary['stale_count']} observations aging without action")
    print(f"  Blind spots: {summary['blind_spot_count']}")
    print(f"  Friction: {summary['friction_boundaries']} project boundaries")

    if result["triggers"]:
        print()
        print("Triggers:")
        for t in result["triggers"]:
            missions = ", ".join(t["missions"]) if t["missions"] else "none"
            print(f"  {t['error_type']}: {t['count']} failures (missions: {missions})")

    if result["stale_observations"]:
        print()
        print("Stale Observations:")
        for o in result["stale_observations"]:
            print(f"  {o['id']}  {o['timestamp'][:10]}  \"{o['content']}\"")

    if result["blind_spots"]:
        print()
        print("Blind Spots:")
        for b in result["blind_spots"]:
            print(f"  {b['error_type']} / {b['mission']}: {b['count']} failures")

    if result["friction"]:
        print()
        print("Friction:")
        for f in result["friction"]:
            print(f"  {f['boundary']}: {f['failure_count']} failures")

    print()
    print("Run `praxis <command> --json` for details.")


def main():
    parser = argparse.ArgumentParser(
        prog="praxis",
        description="Structured failure journals and analysis",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # -- log --
    p = sub.add_parser("log", help="Write a failure journal entry")
    p.add_argument("mission", help="Mission ID")
    p.add_argument("step", type=int, help="Step number")
    p.add_argument("tool", help="Tool that failed (shell, edit, etc)")
    p.add_argument("error_type", help="Error category (UserDeny, NonZeroExit, etc)")
    p.add_argument("message", help="What happened")
    p.set_defaults(func=cmd_log)

    # -- failures --
    p = sub.add_parser("failures", help="Query failure journals")
    p.add_argument("--type", help="Filter by error type")
    p.add_argument("--mission", help="Filter by mission ID")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_failures)

    # -- triggers --
    p = sub.add_parser("triggers", help="Error types hitting Rule of Three")
    p.add_argument("--threshold", type=int, default=3, help="Trigger count (default: 3)")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_triggers)

    # -- timeline --
    p = sub.add_parser("timeline", help="Failure history for a mission")
    p.add_argument("mission", help="Mission ID")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_timeline)

    # -- correlate --
    p = sub.add_parser("correlate", help="Failures alongside nearby decisions")
    p.add_argument("--window", type=int, default=24, help="Hours (default: 24)")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_correlate)

    # -- stale --
    p = sub.add_parser("stale", help="Observations aging without action")
    p.add_argument("--days", type=int, default=7, help="Age threshold (default: 7)")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_stale)

    # -- friction --
    p = sub.add_parser("friction", help="Failures mapped to project boundaries")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_friction)

    # -- blind-spots --
    p = sub.add_parser("blind-spots", help="Recurring failures without journal entries")
    p.add_argument("--threshold", type=int, default=3, help="Failure count threshold (default: 3)")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_blind_spots)

    # -- health --
    p = sub.add_parser("health", help="Ecosystem health summary")
    p.add_argument("--json", action="store_true", help="Output raw JSON")
    p.set_defaults(func=cmd_health)

    args = parser.parse_args()

    try:
        args.func(args)
    except (FileNotFoundError, ValueError, RuntimeError) as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
