#!/usr/bin/env python3
"""praxis -- thin wrapper for backward compatibility.

Prefer `pip install -e .` and the console_scripts entry point.
"""

import sys
from pathlib import Path

# Fallback: add src/ to path if not installed as a package
_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here.parent / "src"))

from praxis.cli import main

if __name__ == "__main__":
    main()
